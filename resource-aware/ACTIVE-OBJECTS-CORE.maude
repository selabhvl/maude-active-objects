  op _or_ : ResourceProfile ResourceProfile -> ResourceProfile [ctor assoc comm id: noneProfile] .
 --- op _or_ : ResourceProfile ResourceProfile -> ResourceProfile [ctor assoc comm] .
    op noneProfile : -> ResourceProfile .
  
