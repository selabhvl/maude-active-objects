pr CONFIGURATION .




 sort Point .
  op mkPoint : Int Int -> Point .

  sort PointList .
  op nil : -> PointList .
  op _._ : Point PointList -> PointList .

  op selectAndRemove : PointList -> PointList .

  var LLLL : PointList .
  vars XXX, YYYY : Int .  

  eq selectAndRemove(nil) = nil .
  eq selectAndRemove(mkPoint(4, YYYY) . LLLL) = LLLL .
  ceq selectAndRemove(mkPoint(XXX, YYYY) . LLLL) = mkPoint(XXX, YYYY) . selectAndRemove(LLLL) if XXX =/= 4 .



 



sort Class .
subsort Class < Qid .



  vars V : ValueOption .
  vars FL : FutureList .
  vars St : FutureState .

  sort FutureList .
  op nil : -> FutureList .
  op _::_ : Object FutureList -> FutureList [ctor] .
  op _::_ : FutureOid FutureList -> FutureList [ctor] .

  op isResolvedF : Object -> Bool .
  eq isResolvedF(< O : Future | value : V, state : resolved >) = true .
  eq isResolvedF(< O : Future | value : V, state : unresolved >) = false .


  op allResolvedList : FutureList -> Bool .
  eq allResolvedList(nil) = true .
  eq allResolvedList(< O : Future | value : V, state : St > :: FL) =
       if isResolvedF(< O : Future | value : V, state : St >)
       then allResolvedList(FL)
       else false
       fi .








