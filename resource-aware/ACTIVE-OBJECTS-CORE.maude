op this : -> Oid . 

op resolveThis : Oid Oid -> Oid .
eq resolveThis(this, O) = O  .
eq resolveThis(E, O) = E [owise] .

 var Pr : ProcessState .
 op bindQ : ProcessPool ProcessState -> ProcessPool .
---< eq bindQ(Q, { LVL | S }) = if Q == emptyPool then { LVL | S } else if containsReturn(S) then { LVL | S } ; Q else  Q ; { LVL | S } fi fi .
 eq bindQ(Q, { LVL | S }) =  if Q == emptyPool then { LVL | S } else Q fi .

vars Y Rest : LocalVar .

op containsVar : LocalVar LocalVarList -> Bool .
---eq containsVar(X, emptyVarList) = false .
eq containsVar(X, Y ; Rest) =  if X =/= Y then containsVar(X, Rest) else true fi .




subsort ResourceProfile < LocalVar .
  
  var PSQ : ProcessState .
    

  var Ffch : FutureOid .
    
var RP : ResourceProfile .

 vars Ffreshed XFfresh : FutureOid .

   op bindParams : ParamList Args FutureOid ResourceProfile -> LocalVarList .
  eq bindParams(P1 P2, (V1, V2), FF1, RP) = ( P1 :== V1 ) ; ( P2 :== V2 ) ; ( destiny :== FF1 ) ; ( rr :== RP ) .
   
  op bind : Oid FutureOid Object Object Args Oid ResourceProfile -> ProcessState .
  eq bind(O, FF1, < MBOD : METHODBODY | stmt : SS >, 
  < SIG : SIGNATURE | ret : AA, name : MethdodN, params : PL >, A, Cid, RP) = 
  { destiny ; bindParams(PL, A, FF1, RP) | SS } .
 



